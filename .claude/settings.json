{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm test*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm -r build*)",
      "Bash(pnpm local:up*)",
      "Bash(pnpm local:down*)",
      "Bash(pnpm tick*)",
      "Bash(docker compose up -d*)",
      "Bash(docker compose ps*)",
      "Bash(cdk synth*)",
      "Bash(cdk diff*)",
      "Bash(pnpm -F @fisio/infra synth*)",
      "Bash(pnpm -F @fisio/infra diff*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git branch -vv)"
    ],
    "ask": [
      "Bash(pnpm deploy:*)",
      "Bash(git push*)",
      "Bash(rm -rf*)",
      "Bash(git diff*--output*)",
      "Bash(git log*--output*)",
      "Bash(git diff*--ext-diff*)"
    ],
    "deny": [
      "Bash(cdk deploy*)",
      "Bash(npx cdk deploy*)",
      "Bash(npx aws-cdk deploy*)",
      "Bash(pnpm exec cdk deploy*)",
      "Bash(pnpm dlx cdk deploy*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/on-ts-edit.mjs",
            "timeout": 90,
            "statusMessage": "Biome + typecheck"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-cdk-deploy.mjs",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
