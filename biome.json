{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/cdk.out",
      "!**/dist",
      "!**/coverage",
      "!**/.vitest",
      "!docs/openapi.json",
      "!apps/web/src/services/api.generated.ts",
      "!**/*.md",
      "!pnpm-lock.yaml"
    ]
  },
  "overrides": [
    {
      "includes": ["apps/web/src/**", "!apps/web/src/**/*.spec.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@fisio/api",
                      "@fisio/api/**",
                      "@fisio/testkit",
                      "@fisio/testkit/**",
                      "@fisio/auth-emulator",
                      "@fisio/auth-emulator/**",
                      "@fisio/local",
                      "@fisio/local/**",
                      "**/test/**"
                    ],
                    "message": "Server and test code never enter the SPA bundle: the SPA talks to the API over HTTP and uses only @fisio/contracts and @fisio/domain."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/pages/**", "!apps/web/src/pages/**/*.spec.{ts,tsx}"],
      "linter": {
        "rules": {
          "performance": {
            "noNamespaceImport": "error"
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@fisio/api",
                      "@fisio/api/**",
                      "@fisio/testkit",
                      "@fisio/testkit/**",
                      "@fisio/auth-emulator",
                      "@fisio/auth-emulator/**",
                      "@fisio/local",
                      "@fisio/local/**",
                      "**/test/**"
                    ],
                    "message": "Server and test code never enter the SPA bundle: the SPA talks to the API over HTTP and uses only @fisio/contracts and @fisio/domain."
                  }
                ],
                "paths": {
                  "rxjs": "Templates contain no logic (CLAUDE.md convention 1): subscribe through useObservable and move the pipeline into a view-model.",
                  "react": {
                    "importNames": [
                      "default",
                      "useState",
                      "useEffect",
                      "useReducer",
                      "useLayoutEffect",
                      "useRef",
                      "useMemo",
                      "useCallback",
                      "useSyncExternalStore",
                      "useContext",
                      "use",
                      "useTransition",
                      "useDeferredValue",
                      "useActionState",
                      "useOptimistic",
                      "useImperativeHandle",
                      "useInsertionEffect"
                    ],
                    "message": "Templates contain no logic (CLAUDE.md convention 1): state and effects live in a view-model; bind with useObservable and useViewModel."
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
