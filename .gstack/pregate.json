      "tools/local/auth-emulator/test/server.spec.ts"
    ],
    "tools/local/seed/package.json": ["tools/local/seed/test/seed.spec.ts"],
    "tools/local/seed/tsconfig.json": ["tools/local/seed/test/seed.spec.ts"],
    "tools/local/seed/vitest.config.ts": ["tools/local/seed/test/seed.spec.ts"],
    "tools/scripts/dev.mjs": []
  },
  "guards": [
    {
      "id": "typecheck",
      "when": ["**/*.ts", "**/*.tsx", "**/tsconfig*.json", "**/package.json"],
      "command": "pnpm typecheck",
      "fix": "fix the reported type errors (pnpm typecheck)"
    },
    {
      "id": "lint",
      "when": ["**/*.ts", "**/*.tsx", "**/*.mjs", "**/*.json"],
      "command": "pnpm lint",
      "fix": "pnpm lint:fix, then fix what remains"
    }
  ]
}
